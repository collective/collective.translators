<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    i18n_domain="collective.translators"
    >

  <genericsetup:registerProfile
      name="default"
      title="Collective Translators: AWS Translate"
      description="Configure the AWS Translate translation service."
      provides="Products.GenericSetup.interfaces.EXTENSION"
      directory="profiles/default"
      />

  <genericsetup:registerProfile
      name="uninstall"
      title="Collective Translators: AWS Translate (uninstall)"
      description="Uninstall the AWS Translate translation service."
      provides="Products.GenericSetup.interfaces.EXTENSION"
      directory="profiles/uninstall"
      />

</configure>
