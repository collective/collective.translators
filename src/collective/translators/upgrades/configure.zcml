<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    >

  <genericsetup:upgradeStep
      title="Split the monolithic profile into one profile per service"
      description="Every translation service now has its own install and uninstall profile. Configured services keep their settings, the others are cleaned up."
      profile="collective.translators:default"
      source="1000"
      destination="1001"
      handler=".to_1001"
      />

  <genericsetup:upgradeStep
      title="Remove Google translator layer and registry records"
      description="Cleans up Google translator layer interface from request/browserlayer registry if present, and removes google registry records and configlet."
      profile="collective.translators:default"
      source="1001"
      destination="1002"
      handler=".to_1002"
      />

  <!-- -*- extra stuff goes here -*- -->

</configure>
