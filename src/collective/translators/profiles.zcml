<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    i18n_domain="collective.translators"
    >

  <genericsetup:registerProfile
      name="default"
      title="Collective Translators: shared base"
      description="Base of the translation services, installed as a dependency of every service. Install it on its own only to run the upgrade steps of an older site."
      provides="Products.GenericSetup.interfaces.EXTENSION"
      directory="profiles/default"
      />

  <genericsetup:registerProfile
      name="uninstall"
      title="Collective Translators: Uninstall"
      description="Remove the shared base. Uninstall the single services first."
      provides="Products.GenericSetup.interfaces.EXTENSION"
      directory="profiles/uninstall"
      />

  <!-- Hide Uninstall Profile-->
  <utility
      factory=".setuphandlers.HiddenProfiles"
      name="collective.translators"
      />


  <include package=".upgrades" />

</configure>
